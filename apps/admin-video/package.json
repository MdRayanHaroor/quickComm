{
  "name": "quickcomm-admin-video",
  "version": "1.0.0",
  "description": "QuickComm Admin Panel demo/explainer video built with Remotion",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render src/index.tsx AdminPanelVideo --output out/quickcomm-admin-demo.mp4",
    "render:hq": "remotion render src/index.tsx AdminPanelVideo --output out/quickcomm-admin-demo-hq.mp4 --codec h264 --crf 16",
    "render:test": "remotion render src/index.tsx AdminPanelVideo out/test.mp4 --frames=0-30"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.290",
    "@remotion/google-fonts": "^4.0.290",
    "@remotion/media-utils": "^4.0.290",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^5.7.0",
    "remotion": "^4.0.290"
  },
  "devDependencies": {
    "@remotion/eslint-config": "^4.0.290",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.4.5"
  },
  "remotion": {
    "entryPoint": "src/index.tsx"
  }
}
